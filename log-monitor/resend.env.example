# Copy to ~/etc/resend.env (chmod 600) and fill in real values.
# Email is sent via the Resend HTTP API (https://resend.com).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# MAIL_FROM must use a domain verified in your Resend account
# (or "onboarding@resend.dev" for first tests — delivers only to your account email).
MAIL_FROM="comet log-monitor <comet@igarreta.net>"
MAIL_TO="rsi@igarreta.com.ar"
